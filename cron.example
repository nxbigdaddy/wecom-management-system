# ============================================================
# 企业微信管理系统 - 定时任务 (Crontab)
# ============================================================
# 
# 服务器: 203.0.113.11
# 项目路径: /www/sites/qywx.example.com/index
# 
# 安装方式:
#   1. 编辑 crontab: crontab -e
#   2. 粘贴下方内容
#   3. 保存退出
# 
# 日志目录:
#   mkdir -p /www/sites/qywx.example.com/log/cron
# 
# ============================================================

# 项目根目录
PROJECT_DIR=/www/sites/qywx.example.com/index
LOG_DIR=/www/sites/qywx.example.com/log/cron

# ============================================================
# 通讯录同步（每天凌晨 2:00）
# 从企业微信 API 同步部门、成员到本地数据库
# ============================================================
0 2 * * * /usr/bin/php ${PROJECT_DIR}/src/sync/SyncContacts.php >> ${LOG_DIR}/sync_contacts.log 2>&1

# ============================================================
# 客户数据同步（每天凌晨 3:00）
# 同步客户列表、跟进关系、客户群到本地数据库
# ============================================================
0 3 * * * /usr/bin/php ${PROJECT_DIR}/src/sync/SyncExternalContacts.php >> ${LOG_DIR}/sync_external.log 2>&1

# ============================================================
# 标签同步（每天凌晨 4:00）
# 同步企业标签及标签成员关联
# ============================================================
0 4 * * * /usr/bin/php ${PROJECT_DIR}/src/sync/SyncTags.php >> ${LOG_DIR}/sync_tags.log 2>&1

# ============================================================
# 日志清理（每天凌晨 5:00）
# 清理 90 天前的回调日志和 API 请求日志
# ============================================================
0 5 * * * /usr/bin/php ${PROJECT_DIR}/src/sync/CleanLogs.php >> ${LOG_DIR}/clean_logs.log 2>&1

# ============================================================
# access_token 预热（每 1 小时）
# 确保 access_token 始终在有效期内
# ============================================================
0 * * * * /usr/bin/php -r "require '${PROJECT_DIR}/vendor/autoload.php'; \Wxwork\Wxwork::create()->getTokenManager()->getToken();" >> ${LOG_DIR}/token_warmup.log 2>&1

# ============================================================
# 可选: 每 5 分钟检查服务健康
# ============================================================
# */5 * * * * /usr/bin/curl -s http://qywx.example.com/ > /dev/null || echo "[$(date)] 服务不可用" >> ${LOG_DIR}/health.log
